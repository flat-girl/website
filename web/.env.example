# Copy to web/.env (ignored by git) and restart npm run dev.
# One switch for products, policies and checkout. Signup is separate (Brevo).
FLAT_GIRL_COMMERCE_SOURCE=shopify
# Public token: direct browser requests; takes precedence, with no private fallback.
NUXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Optional private token: used via the dev server only when the public token is empty.
NUXT_SHOPIFY_STOREFRONT_TOKEN=

# To return to local products, editable policy drafts and mock checkout:
# FLAT_GIRL_COMMERCE_SOURCE=local
